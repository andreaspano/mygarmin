# Il giro del mattino: la pagina e' gia' scritta quando la apri.
[Unit]
Description=Daily training report, morning run

[Timer]
OnCalendar=*-*-* 10:00
# Un giro saltato a macchina spenta o addormentata si recupera al risveglio
# invece di perdersi.
Persistent=true
Unit=mygarmin-report@morning.service

[Install]
WantedBy=timers.target
